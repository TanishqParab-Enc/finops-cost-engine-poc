# Copy to .env (git-ignored) or store in your CI/CD secret store.
# NEVER commit real values.

# ---------------------------------------------------------------------------
# Infracost - the authoritative cost estimation engine.
#
# Get a FREE API key:  infracost auth login            (CLI v2)
#                      infracost configure get api_key (read it back)
# The free tier covers CI/CD cost estimation for Terraform/CloudFormation/CDK.
# No cloud credentials and no Terraform plan file are sent to Infracost; only
# cost-relevant parameters (e.g. instance type, region) are used to look up
# prices.
# ---------------------------------------------------------------------------
# CLI v2 (current)
# INFRACOST_CLI_AUTHENTICATION_TOKEN=
# CLI v0.10 (legacy, still used by the infracost/infracost:ci-0.10 image)
# INFRACOST_API_KEY=

# Optional Infracost behaviour
# INFRACOST_CLI_CURRENCY=USD
# INFRACOST_CLI_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# FinOps threshold overrides (config/finops-policy.yaml is the source of truth)
# ---------------------------------------------------------------------------
# FINOPS_THRESHOLD_VALUE=100
# FINOPS_THRESHOLD_METRIC=incremental_monthly_cost
# FINOPS_THRESHOLD_CURRENCY=USD

# ---------------------------------------------------------------------------
# Estimator selection: infracost | infracost_fixture | mock
# "mock" is for tests only and cannot produce a cost lock.
# ---------------------------------------------------------------------------
# FINOPS_COST_ESTIMATOR=infracost

# ---------------------------------------------------------------------------
# AI provider: mock | bedrock | azure_openai | openai
# AI is used for EXPLANATION ONLY - never for the monetary calculation.
# ---------------------------------------------------------------------------
# FINOPS_AI_PROVIDER=bedrock

# AWS Bedrock (uses the same OIDC role as terraform plan - no extra key needed)
# FINOPS_BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
# FINOPS_BEDROCK_REGION=us-east-1

# Azure OpenAI (alternative)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI (alternative)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Cloud credentials - required ONLY by `terraform plan`, never by the engine.
# Use read-only roles. Prefer OIDC / workload identity federation in CI.
# ---------------------------------------------------------------------------
# AWS_REGION=us-east-1
# ARM_SUBSCRIPTION_ID=
# GOOGLE_PROJECT=

# ---------------------------------------------------------------------------
# PR feedback
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=
